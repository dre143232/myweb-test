[
 {
  "escena": 1,
  "inicio": 1.3,
  "fin": 3.14,
  "texto": "Hay momentos en la vida"
 },
 {
  "escena": 1,
  "inicio": 3.24,
  "fin": 6.468,
  "texto": "cuando sentimos que las fuerzas se nos terminan…"
 },
 {
  "escena": 2,
  "inicio": 10.7,
  "fin": 12.738,
  "texto": "Las dificultades llegan,"
 },
 {
  "escena": 2,
  "inicio": 12.958,
  "fin": 14.551,
  "texto": "las puertas se cierran"
 },
 {
  "escena": 2,
  "inicio": 14.671,
  "fin": 16.687,
  "texto": "y pensamos que estamos solos…"
 },
 {
  "escena": 3,
  "inicio": 21.0,
  "fin": 23.202,
  "texto": "Pero Dios nos dejó una promesa"
 },
 {
  "escena": 3,
  "inicio": 23.252,
  "fin": 26.288,
  "texto": "en Isaías 43:2:"
 },
 {
  "escena": 3,
  "inicio": 26.838,
  "fin": 29.109,
  "texto": "Cuando pasares por las aguas,"
 },
 {
  "escena": 3,
  "inicio": 29.289,
  "fin": 30.677,
  "texto": "yo seré contigo;"
 },
 {
  "escena": 3,
  "inicio": 31.077,
  "fin": 33.654,
  "texto": "y por los ríos, no te anegarán."
 },
 {
  "escena": 4,
  "inicio": 36.2,
  "fin": 38.56,
  "texto": "Cuando pasares por el fuego,"
 },
 {
  "escena": 4,
  "inicio": 38.81,
  "fin": 40.18,
  "texto": "no te quemarás,"
 },
 {
  "escena": 4,
  "inicio": 40.48,
  "fin": 42.455,
  "texto": "ni la llama arderá en ti."
 },
 {
  "escena": 5,
  "inicio": 47.6,
  "fin": 48.426,
  "texto": "Recuerda:"
 },
 {
  "escena": 5,
  "inicio": 48.726,
  "fin": 52.113,
  "texto": "la prueba no significa que Dios te abandonó."
 },
 {
  "escena": 5,
  "inicio": 52.563,
  "fin": 55.152,
  "texto": "Aunque el camino sea difícil,"
 },
 {
  "escena": 5,
  "inicio": 55.302,
  "fin": 56.785,
  "texto": "Él sigue contigo."
 },
 {
  "escena": 5,
  "inicio": 57.285,
  "fin": 58.519,
  "texto": "¡No pierdas la fe!"
 }
]